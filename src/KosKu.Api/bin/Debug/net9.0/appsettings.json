{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kosku-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=10.116.205.64;Port=3306;Database=kosku_db;Username=arofan_app;Password=Beruangtato7;"
  },
  "JwtSettings": {
    "SecretKey": "KosKu-Super-Secret-Key-That-Is-At-Least-32-Characters-Long!",
    "Issuer": "KosKu.Api",
    "Audience": "KosKu.Client",
    "ExpirationMinutes": "1440"
  },
  "AllowedHosts": "*"
}
